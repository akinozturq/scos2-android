<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#B3000000"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <View
        android:id="@+id/overlay_drag_handle"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_marginBottom="6dp"
        android:background="#80FFFFFF" />

    <androidx.camera.view.PreviewView
        android:id="@+id/overlay_preview"
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <ImageButton android:id="@+id/btn_capture" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" android:background="@null" android:contentDescription="Capture" />
    <ImageButton android:id="@+id/btn_burst" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_gallery" android:background="@null" android:contentDescription="Burst" />
    <ImageButton android:id="@+id/btn_video" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_slideshow" android:background="@null" android:contentDescription="Video" />
    <ImageButton android:id="@+id/btn_preview" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_view" android:background="@null" android:contentDescription="Preview" />
    <ImageButton android:id="@+id/btn_face" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_myplaces" android:background="@null" android:contentDescription="Face Detection" />
    <ImageButton android:id="@+id/btn_switch" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_rotate" android:background="@null" android:contentDescription="Switch" />
    <ImageButton android:id="@+id/btn_black" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_lock_lock" android:background="@null" android:contentDescription="Black" />
    <ImageButton android:id="@+id/btn_hide" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:background="@null" android:contentDescription="Hide" />
    <ImageButton android:id="@+id/btn_exit" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_lock_power_off" android:background="@null" android:contentDescription="Exit" />
</LinearLayout>
